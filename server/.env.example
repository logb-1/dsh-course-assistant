# 本地开发用；生产环境在 Render 面板里配同样的变量
# 模型：DeepSeek 的 OpenAI 兼容端点
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_API_KEY=sk-换成你自己的

# 注册需要邀请码时填，留空 = 开放注册
SIGNUP_CODE=

# 本地默认 SQLite；线上填 Neon/Postgres 的 URL
# DATABASE_URL=postgresql+psycopg://user:pass@host/db?sslmode=require

# 线上必须 true（HTTPS）
SECURE_COOKIES=false

JOBS_PER_DAY=3
MAX_UPLOAD_MB=40
MAX_FILES=3
NODE_BIN=node
