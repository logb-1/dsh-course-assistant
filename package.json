{
  "name": "dsh-course-assistant",
  "version": "1.11.0",
  "private": false,
  "type": "module",
  "description": "课程文件 → 目录识别 · 分章知识点总结 · B 站网课推荐 · 学习报告（DeepSeek Harness bundle）",
  "author": "logb-1",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/logb-1/dsh-course-assistant.git"
  },
  "homepage": "https://github.com/logb-1/dsh-course-assistant#readme",
  "bugs": {
    "url": "https://github.com/logb-1/dsh-course-assistant/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "course",
    "slides",
    "pptx",
    "pdf",
    "bilibili",
    "study-notes"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "core/*.js",
    "core/ocr.ps1",
    "core/rapidocr.py",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1"
  },
  "dependencies": {
    "schemastery": "^3.18.0"
  }
}
